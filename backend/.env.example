# Copy this file to `.env` and fill in real values. `.env` is gitignored --
# never commit real secrets to version control.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Use this URI when running the backend directly on your host machine
# (outside Docker), with MongoDB started via `docker compose up mongodb`.
# If running the FULL stack via docker-compose, that file sets its own
# MONGODB_URI internally (mongodb://mongodb:27017) -- you don't need to
# change anything here for that case.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=meeting_ai

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# --- Auth (used starting Phase 4) ---
JWT_SECRET_KEY=change-me-to-a-random-64-char-string-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# --- Google OAuth (Phase 4) ---
# Create a Google Cloud project: https://console.cloud.google.com/
# Enable "Google+ API" and create OAuth 2.0 credentials under APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SESSION_SECRET_KEY=change-me-to-a-random-64-char-string

# --- Whisper / Audio (Phase 2) ---
# Options: "local" (uses openai-whisper package, no API key needed)
WHISPER_PROVIDER=local
# Whisper model size: tiny, base, small, medium, large (larger = better quality, slower)
WHISPER_MODEL=base
AUDIO_MAX_SIZE_MB=25
AUDIO_MAX_DURATION_SECONDS=7200

# --- LLM Extraction (Phase 3) ---
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Search (Phase 5) ---
USE_ATLAS_SEARCH=false
ATLAS_SEARCH_INDEX=meeting_search

# --- Export (Phase 5) ---
EXPORT_MAX_SIZE_MB=10
